NODE_ENV=development
PORT=5000

# Client URLs (comma-separated allowed origins, NO trailing slash)
CLIENT_URL=http://localhost:5173,http://localhost:5174
TRUST_PROXY=1

# MySQL Database URL (XAMPP: user root, password khali)
DATABASE_URL="mysql://root:@127.0.0.1:3306/digiamplify"

# JWT Secrets (min 16 characters each)
JWT_ACCESS_SECRET=digiamplify_local_access_secret_key_2026_abc123
JWT_REFRESH_SECRET=digiamplify_local_refresh_secret_key_2026_xyz789
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Initial Admin Seeder (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@12345678

# Optional Notifications & URLs
CONTACT_NOTIFY_EMAIL=admin@gmail.com
MARKETING_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173