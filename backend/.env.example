NODE_ENV=development
PORT=5000

# Client URLs (comma-separated allowed origins, NO trailing slash)
CLIENT_URL=http://localhost:5173,http://localhost:5174
TRUST_PROXY=1

# MySQL Database URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/digiamplify"

# JWT Secrets (min 16 characters each)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_16_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_16_chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Initial Admin Seeder (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# Optional Notifications & URLs
CONTACT_NOTIFY_EMAIL=admin@example.com
MARKETING_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
