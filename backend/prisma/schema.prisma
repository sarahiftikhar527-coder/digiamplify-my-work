
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String    @db.VarChar(100)
  email                  String    @unique @db.VarChar(191)
  passwordHash           String    @db.VarChar(255)
  role                   String    @default("employee") @db.VarChar(50)
  position               String    @default("employee") @db.VarChar(50)
  phone                  String    @default("") @db.VarChar(50)
  department             String    @default("") @db.VarChar(100)
  designation            String    @default("") @db.VarChar(100)
  avatarUrl              String?   @db.Text
  timeZone               String    @default("UTC") @db.VarChar(100)
  status                 String    @default("active") @db.VarChar(50)
  isDeleted              Boolean   @default(false)
  pinHash                String?   @db.VarChar(255)
  pinResetTokenHash      String?   @db.VarChar(255)
  pinResetExpires        DateTime?
  passwordResetTokenHash String?   @db.VarChar(255)
  passwordResetExpires   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  managerId String? @db.VarChar(191)
  manager   User?   @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserHierarchy")

  profile                  Profile?
  refreshTokens            RefreshToken[]
  attendances              Attendance[]
  assignedShifts           ShiftAssignment[]        @relation("AssignedToShift")
  createdShifts            ShiftAssignment[]        @relation("CreatedShift")
  leaves                   Leave[]                  @relation("EmployeeLeaves")
  reviewedLeaves           Leave[]                  @relation("ReviewedLeaves")
  assignedTasks            Task[]                   @relation("AssignedTasks")
  createdTasks             Task[]                   @relation("CreatedTasks")
  taskComments             TaskComment[]            @relation("TaskCommentAuthor")
  taskCommentReadStates    TaskCommentReadState[]
  calendarEvents           Calendar[]               @relation("EmployeeCalendar")
  createdCalendarEvents    Calendar[]               @relation("CreatedCalendar")
  reviewedCalendarEvents   Calendar[]               @relation("ReviewedCalendar")
  createdChats             Chat[]                   @relation("CreatedChats")
  chatConversationsCreated ChatConversation[]       @relation("ChatConversationCreator")
  chatMemberships          ChatMember[]             @relation("ChatMemberUser")
  chatMessagesSent         ChatMessage[]            @relation("ChatMessageSender")
  chatAttachmentsUploaded  ChatAttachment[]         @relation("ChatAttachmentUploader")
  chatReactions            ChatReaction[]           @relation("ChatReactionUser")
  finances                 Finance[]                @relation("EmployeeFinances")
  createdFinances          Finance[]                @relation("CreatedFinances")
  updatedFinances          Finance[]                @relation("UpdatedFinances")
  receivedNotifications    Notification[]           @relation("ReceivedNotifications")
  sentNotifications        Notification[]           @relation("SentNotifications")
  notificationPreferences  NotificationPreference[]
  createdAnnouncements     Announcement[]           @relation("CreatedAnnouncements")
  progressReports          ProgressReport[]         @relation("EmployeeProgressReports")
  reviewedProgressReports  ProgressReport[]         @relation("ReviewedProgressReports")
  profileChangeRequests    ProfileChangeRequest[]   @relation("RequestedProfileChanges")
  reviewedProfileChanges   ProfileChangeRequest[]   @relation("ReviewedProfileChanges")
  organizedMeetings        Meeting[]                @relation("MeetingOrganizer")
  meetingAttendances       MeetingAttendee[]        @relation("MeetingAttendee")

  @@index([role])
  @@index([position])
  @@index([isDeleted])
  @@index([managerId])
  @@index([passwordResetTokenHash])
  @@map("users")
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String   @default("") @db.VarChar(191)
  userName            String   @default("") @db.VarChar(191)
  dob                 String   @default("") @db.VarChar(50)
  gender              String   @default("") @db.VarChar(50)
  nationality         String   @default("") @db.VarChar(100)
  language            String   @default("") @db.VarChar(100)
  email               String   @default("") @db.VarChar(191)
  workEmail           String   @default("") @db.VarChar(191)
  phone               String   @default("") @db.VarChar(50)
  emergencyNumber     String   @default("") @db.VarChar(50)
  currentAddress      String?  @db.Text
  permanentAddress    String?  @db.Text
  country             String   @default("") @db.VarChar(100)
  city                String   @default("") @db.VarChar(100)
  education           String   @default("") @db.VarChar(191)
  bankName            String   @default("") @db.VarChar(191)
  annualSalary        Float    @default(0)
  accountHolder       String   @default("") @db.VarChar(191)
  salaryType          String   @default("Monthly") @db.VarChar(50)
  accountNumber       String   @default("") @db.VarChar(100)
  salary              Float    @default(0)
  currency            String   @default("Rupees") @db.VarChar(50)
  deductionPerAbsence Float    @default(0)
  bonus               Float    @default(0)
  salaryPaymentDate   String   @default("") @db.VarChar(50)
  jobTitle            String   @default("") @db.VarChar(100)
  department          String   @default("") @db.VarChar(100)
  team                String   @default("") @db.VarChar(100)
  manager             String   @default("") @db.VarChar(100)
  jobLevel            String   @default("Junior") @db.VarChar(50)
  probationPeriod     String   @default("") @db.VarChar(50)
  dateOfJoining       String   @default("") @db.VarChar(50)
  confirmationDate    String   @default("") @db.VarChar(50)
  annualLeave         Int      @default(0)
  jobType             String   @default("Full Time") @db.VarChar(50)
  workType            String   @default("Remote") @db.VarChar(50)
  shift               String   @default("Day Shift") @db.VarChar(50)
  workingDays         Json?
  weeklyOff           String   @default("Sunday") @db.VarChar(50)
  noticePeriod        String   @default("") @db.VarChar(50)
  avatarUrl           String?  @db.Text
  documents           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("profiles")
}

model ProfileChangeRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("RequestedProfileChanges", fields: [userId], references: [id], onDelete: Cascade)
  changes      Json
  previous     Json?
  status       String    @default("pending") @db.VarChar(20)
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedProfileChanges", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String    @default("") @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("profile_change_requests")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

model Attendance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey       String    @db.VarChar(50)
  clockInAt     DateTime?
  clockOutAt    DateTime?
  workedMinutes Int       @default(0)
  status        String    @default("incomplete") @db.VarChar(50)
  description   String    @default("") @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, dateKey])
  @@index([dateKey, status])
  @@map("attendances")
}

model ShiftAssignment {
  id           String    @id @default(uuid())
  employeeId   String
  employee     User      @relation("AssignedToShift", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?     @relation("CreatedShift", fields: [assignedById], references: [id], onDelete: SetNull)
  startDate    String    @db.VarChar(50)
  endDate      String    @db.VarChar(50)
  startTime    String    @db.VarChar(50)
  endTime      String    @db.VarChar(50)
  breakStart   String    @default("") @db.VarChar(50)
  breakEnd     String    @default("") @db.VarChar(50)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, startDate, endDate])
  @@map("shift_assignments")
}

model Leave {
  id           String    @id @default(uuid())
  employeeId   String
  employee     User      @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  type         String    @db.VarChar(100)
  from         String    @db.VarChar(50)
  to           String    @db.VarChar(50)
  days         Int
  reason       String    @db.Text
  status       String    @default("pending") @db.VarChar(50)
  remarks      String?   @db.Text
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  appliedOn    String    @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Task {
  id               String            @id @default(uuid())
  title            String            @db.VarChar(200)
  subtitle         String            @default("") @db.VarChar(200)
  description      String?           @db.Text
  priority         String            @default("Medium") @db.VarChar(50)
  taskType         String            @default("extra") @db.VarChar(20)
  startDate        DateTime?
  isActive         Boolean           @default(true)
  assignedToId     String
  assignedTo       User              @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById     String
  assignedBy       User              @relation("CreatedTasks", fields: [assignedById], references: [id], onDelete: Cascade)
  status           String            @default("pending") @db.VarChar(50)
  dueDate          DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  timeSpentMinutes Int               @default(0)

  submissionNote   String?           @db.Text
  submittedAt      DateTime?
  reviewNote       String?           @db.Text
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedByName   String?           @db.VarChar(150)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyUpdates     TaskDailyUpdate[]
  comments         TaskComment[]
  commentReadStates TaskCommentReadState[]

  @@index([assignedToId, status, dueDate])
  @@index([taskType, isActive])
  @@map("tasks")
}

model TaskDailyUpdate {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId       String
  updateDate       String   @db.VarChar(10)
  description      String?  @db.Text
  status           String   @default("in-progress") @db.VarChar(30)
  timeSpentMinutes Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([taskId, updateDate])
  @@index([employeeId, updateDate])
  @@map("task_daily_updates")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

model TaskCommentReadState {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, userId])
  @@index([userId, lastReadAt])
  @@map("task_comment_read_states")
}

model Calendar {
  id           String    @id @default(uuid())
  eventType    String    @db.VarChar(50)
  title        String    @default("") @db.VarChar(200)
  employeeId   String?
  employee     User?     @relation("EmployeeCalendar", fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName String    @default("") @db.VarChar(100)
  role         String    @default("") @db.VarChar(100)
  from         DateTime
  to           DateTime
  startTime    String    @default("") @db.VarChar(50)
  endTime      String    @default("") @db.VarChar(50)
  clockIn      String    @default("") @db.VarChar(50)
  clockOut     String    @default("") @db.VarChar(50)
  worked       String    @default("") @db.VarChar(50)
  status       String    @default("pending") @db.VarChar(50)
  description  String?   @db.Text
  createdById  String?
  createdBy    User?     @relation("CreatedCalendar", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedCalendar", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([from, to, eventType])
  @@index([employeeId, from])
  @@map("calendars")
}

model Chat {
  id              String   @id @default(uuid())
  type            String   @default("direct") @db.VarChar(50)
  name            String   @default("") @db.VarChar(100)
  createdById     String
  createdBy       User     @relation("CreatedChats", fields: [createdById], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime @default(now())
  lastMessageText String?  @db.Text
  members         Json?
  messages        Json?
  admins          Json?
  clearedFor      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("chats")
}

model Finance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    User      @relation("EmployeeFinances", fields: [employeeId], references: [id], onDelete: Cascade)
  salary      Float
  bonus       Float     @default(0)
  deduction   Float     @default(0)
  department  String    @default("") @db.VarChar(100)
  bank        String    @default("") @db.VarChar(100)
  account     String    @default("") @db.VarChar(100)
  paymentDate DateTime?
  periodMonth Int
  periodYear  Int
  status      String    @default("Pending") @db.VarChar(50)
  notes       String?   @db.Text
  receiptMeta Json?
  createdById String?
  createdBy   User?     @relation("CreatedFinances", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("UpdatedFinances", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, periodYear, periodMonth])
  @@index([status])
  @@map("finances")
}

model Notification {
  id        String   @id @default(uuid())
  toId      String
  to        User     @relation("ReceivedNotifications", fields: [toId], references: [id], onDelete: Cascade)
  fromId    String?
  from      User?    @relation("SentNotifications", fields: [fromId], references: [id], onDelete: SetNull)
  type      String   @db.VarChar(50)
  tag       String   @db.VarChar(50)
  title     String   @db.VarChar(150)
  message   String   @db.VarChar(500)
  details   String?  @db.Text
  link      String?  @db.Text
  linkLabel String   @default("") @db.VarChar(100)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(100)
  on        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("notification_preferences")
}

model ContactMessage {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(200)
  email       String   @db.VarChar(191)
  company     String   @default("") @db.VarChar(200)
  projectType String   @db.VarChar(120)
  message     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id                   String    @id @default(uuid())
  email                String    @unique @db.VarChar(191)
  unsubscribeTokenHash String    @db.VarChar(255)
  subscribedAt         DateTime  @default(now())
  unsubscribedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("newsletter_subscribers")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(150)
  message     String   @db.Text
  audience    String   @default("all") @db.VarChar(50)
  employeeIds Json?
  priority    String   @default("normal") @db.VarChar(50)
  status      String   @default("published") @db.VarChar(50)
  createdById String
  createdBy   User     @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("announcements")
}

model ProgressReport {
  id              String    @id @default(uuid())
  employeeId      String
  employee        User      @relation("EmployeeProgressReports", fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  summary         String    @db.Text
  accomplishments String?   @db.Text
  blockers        String?   @db.Text
  nextSteps       String?   @db.Text
  status          String    @default("submitted") @db.VarChar(50)
  adminFeedback   String?   @db.Text
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedProgressReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, periodStart])
  @@index([status])
  @@map("progress_reports")
}

model AttendanceSession {
  id            String    @id @default(uuid())
  userId        String
  dateKey       String    @db.VarChar(50)
  clockInAt     DateTime
  clockOutAt    DateTime?
  workedMinutes Int       @default(0)
  breakMinutes  Int       @default(0)
  description   String    @default("") @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  breaks AttendanceBreak[]

  @@index([userId, dateKey])
  @@index([dateKey])
  @@map("attendance_sessions")
}

model AttendanceBreak {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  dateKey   String            @db.VarChar(50)
  type      String            @default("other") @db.VarChar(30)
  startAt   DateTime
  endAt     DateTime?
  minutes   Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, dateKey])
  @@index([sessionId])
  @@map("attendance_breaks")
}

model Meeting {
  id                        String            @id @default(uuid())
  title                     String            @db.VarChar(200)
  description               String?           @db.Text
  agenda                    String?           @db.Text
  notes                     String?           @db.Text
  meetingType               String            @default("online") @db.VarChar(20)
  category                  String            @default("general") @db.VarChar(30)
  priority                  String            @default("normal") @db.VarChar(20)
  location                  String            @default("") @db.VarChar(255)
  meetingLink               String            @default("") @db.VarChar(500)
  startAt                   DateTime
  endAt                     DateTime
  tzOffset                  Int               @default(0)
  recurrence                String            @default("none") @db.VarChar(20)
  recurrenceUntil           DateTime?
  skippedDates              Json?
  reminderMinutes           Int               @default(15)
  lastReminderFor           DateTime?
  reminderScheduleUpdatedAt DateTime          @default(now())
  status                    String            @default("scheduled") @db.VarChar(20)
  cancelReason              String            @default("") @db.VarChar(500)
  organizerId               String
  organizer                 User              @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attendees                 MeetingAttendee[]
  reminderDeliveries        MeetingReminder[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([startAt, endAt])
  @@index([organizerId, startAt])
  @@index([status, startAt])
  @@map("meetings")
}

model MeetingAttendee {
  id          String    @id @default(uuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      String
  user        User      @relation("MeetingAttendee", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rsvp        String    @default("pending") @db.VarChar(20)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
}

model MeetingReminder {
  id              String   @id @default(uuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  occurrenceStart DateTime
  minutesBefore   Int
  sentAt          DateTime @default(now())

  @@unique([meetingId, occurrenceStart, minutesBefore])
  @@index([meetingId])
  @@map("meeting_reminders")
}

model ChatConversation {
  id              String   @id @default(uuid())
  type            String   @default("direct") @db.VarChar(20)
  name            String   @default("") @db.VarChar(120)
  uniqueKey       String?  @unique @db.VarChar(191)
  createdById     String
  createdBy       User     @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime @default(now())
  lastMessageText String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members  ChatMember[]
  messages ChatMessage[]

  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model ChatMember {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ChatMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role           String           @default("member") @db.VarChar(20)
  lastReadAt     DateTime?
  clearedAt      DateTime?
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("chat_members")
}

model ChatMessage {
  id              String           @id @default(uuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  text            String           @default("") @db.Text
  replyToId       String?
  replyTo         ChatMessage?     @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]    @relation("ChatMessageReplies")
  forwardedFromId String?          @db.VarChar(191)
  pinned          Boolean          @default(false)
  pinnedById      String?          @db.VarChar(191)
  deleted         Boolean          @default(false)
  mentions        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatAttachment {
  id           String       @id @default(uuid())
  fileName     String       @db.VarChar(191)
  originalName String       @db.VarChar(255)
  mimeType     String       @default("application/octet-stream") @db.VarChar(150)
  size         Int          @default(0)
  uploaderId   String
  uploader     User         @relation("ChatAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  messageId    String?
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([fileName])
  @@index([messageId])
  @@index([uploaderId, messageId])
  @@map("chat_attachments")
}

model ChatReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@map("chat_reactions")
}
