datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  role              String   @default("Employee")
  pin               String
  status            String   @default("PENDING")
  editRequestStatus String   @default("NONE")
  lastLogin         DateTime?
  isOnline          Boolean   @default(false)
  lastSeen          Int?
  chatLastActive    Int?
  profile           Profile?
  supportTickets    SupportTicket[]
  attendances       Attendance[]
  transactions      Transaction[]
  tasks                  Task[]         @relation("UserTasks")
  assignedTasks          Task[]         @relation("AdminTasks")
  taskActivities         TaskActivity[]
  taskRequestsAssignedTo TaskRequest[]  @relation("AssignedToUser")
  taskRequestsCreated    TaskRequest[]  @relation("RequestedByUser")
  chatParticipants  Participant[]
  chatMessages      Message[]
  groupRequestsCreated GroupRequest[] @relation("GroupRequestsCreated")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Details
  fullName         String?
  userName         String?
  dateOfBirth      String?
  gender           String?
  nationality      String?
  language         String?
  
  // Contact
  email            String?
  workEmail        String?
  phone            String?
  emergencyPhone   String?
  
  // Address & Education
  currentAddress   String?
  permanentAddress String?
  country          String?
  city             String?
  education        String?

  // Job Details
  jobTitle         String?
  department       String?
  team             String?
  manager          String?
  jobLevel         String?
  probationPeriod  String?
  dateOfJoining    String?
  confirmationDate String?
  annualLeave      String?
  jobType          String?
  workType         String?
  shift            String?
  workingDays      String? // comma-separated e.g. "Mon,Tue"
  weeklyOff        String?
  noticePeriod     String?

  // Payment Details
  bankName         String?
  accountHolderName String?
  accountNumber    String?
  currency         String?
  bonus            String?
  annualSalary     String?
  salaryType       String?
  salary           String?
  deductionPerAbsence String?
  paymentDate      String?

  // Documents
  cnicFileName     String?
  cnicContent      String?  @db.LongText
  cnicStatus       String?

  cvFileName       String?
  cvContent        String?  @db.LongText
  cvStatus         String?

  contractFileName String?
  contractContent  String?  @db.LongText
  contractStatus   String?

  pictureUrl       String?  @db.LongText
  pictureStatus    String?

  portfolioUrl     String?  @db.LongText
  portfolioStatus  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SupportTicket {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueType      String
  subject        String
  priority       String
  description    String   @db.LongText
  fileName       String?
  fileContent    String?  @db.LongText
  contactMethod  String
  status         String   @default("PENDING")
  adminResponse  String?  @db.LongText
  respondedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Attendance {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String    // Format: YYYY-MM-DD
  clockIn      DateTime?
  clockOut     DateTime?
  status       String    // "ON_TIME", "LATE", "CLOCKED_OUT"
  lateDuration String?   // e.g., "18m" or "1h 15m"
  description  String?   @db.LongText
  breaks       Break[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
}

model Break {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime?
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  reference String
  amount    Float
  type      String
  date      DateTime @default(now())
  status    String
}

model Task {
  id             String   @id @default(uuid())
  taskGroupId    String?
  assignedToId   String
  assignedTo     User     @relation("UserTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?    @relation("AdminTasks", fields: [assignedById], references: [id], onDelete: SetNull)
  subject        String
  priority       String
  description    String   @db.LongText
  dueDate        String
  dueTime        String?
  fileName       String?
  fileContent    String?  @db.LongText
  status         String   @default("PENDING")
  progress       Int      @default(0)
  completionFileName String?
  completionFileContent String?  @db.LongText
  completionUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activities     TaskActivity[]
}

model TaskActivity {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String   @db.LongText
  createdAt   DateTime @default(now())
}

model TaskRequest {
  id              String   @id @default(uuid())
  taskGroupId     String?
  assignedToId    String
  assignedTo      User     @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById    String
  assignedBy      User     @relation("RequestedByUser", fields: [assignedById], references: [id], onDelete: Cascade)
  subject         String
  priority        String
  description     String   @db.LongText
  dueDate         String
  dueTime         String?
  fileName        String?
  fileContent     String?  @db.LongText
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?  @db.LongText
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatRoom {
  id               String        @id @default(uuid())
  name             String?       // null for 1-to-1 direct message
  isGroup          Boolean       @default(false)
  groupPicture     String?       @db.LongText // base64 representation of group avatar
  description      String?       @db.LongText
  pinnedMessageIds String?       @db.LongText // JSON array of pinned message IDs
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  participants     Participant[]
  messages         Message[]
}

model Participant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  role       String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt   DateTime @default(now())
  lastRead   DateTime @default(now())

  @@unique([userId, chatRoomId])
}

model Message {
  id          String   @id @default(uuid())
  chatRoomId  String
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content     String   @db.LongText
  fileName    String?
  fileContent String?  @db.LongText
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model GroupRequest {
  id              String   @id @default(uuid())
  groupName       String
  requestedById   String
  requestedBy     User     @relation("GroupRequestsCreated", fields: [requestedById], references: [id], onDelete: Cascade)
  memberIds       String   @db.LongText // JSON array of user IDs
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

